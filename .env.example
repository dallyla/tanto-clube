# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://tantoclube.com.br

# ─── Database (Neon Postgres) ──────────────────────────────────────────────────
# Get from: console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://user:password@host/tanto_clube?sslmode=require

# ─── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_secret_here

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Last.fm API ───────────────────────────────────────────────────────────────
# Get from: last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# ─── Upstash Redis ─────────────────────────────────────────────────────────────
# Get from: console.upstash.com → Redis → your db → REST API
UPSTASH_REDIS_REST_URL=https://your-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# ─── Resend (email) ────────────────────────────────────────────────────────────
# Get from: resend.com/api-keys
RESEND_API_KEY=re_your_key

# ─── Vercel Blob ───────────────────────────────────────────────────────────────
# Auto-populated by Vercel when you add Blob storage to your project
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# ─── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key
VAPID_SUBJECT=mailto:suporte@tantoclube.com.br

# ─── Cron (cron-job.org) ───────────────────────────────────────────────────────
# Set a strong random string — same value goes in cron-job.org header: x-cron-secret
CRON_SECRET=your_cron_secret_here

# ─── Sentry ────────────────────────────────────────────────────────────────────
# Get from: sentry.io → your project → Settings → SDK Setup
NEXT_PUBLIC_SENTRY_DSN=https://your_dsn@sentry.io/your_project
SENTRY_AUTH_TOKEN=your_sentry_token
SENTRY_ORG=your_org
SENTRY_PROJECT=tanto-clube
